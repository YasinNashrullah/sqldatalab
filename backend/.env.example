ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-sqltrainweb-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=datalab_session

DATABASE_URL=sqlite+aiosqlite:///storage/metadata.db

AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=5.0
AI_COMBO_FALLBACK=true

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 9router (OpenAI-compatible gateway)
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=https://api.9router.com/v1
NINEROUTER_MODEL=gpt-4o-mini

# OpenRouter / Generic Gateway
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gemini-2.5-flash

# DuckDB Sandbox
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
QUERY_TIMEOUT_SECONDS=20
MAX_RESULT_ROWS=1000
MAX_UPLOAD_SIZE_BYTES=52428800
